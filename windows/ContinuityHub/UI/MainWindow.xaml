<Window x:Class="ContinuityHub.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ContinuityHub.UI"
        Title="Strand" Width="1040" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
    <Window.Resources>
        <ui:EnumMatchConverter x:Key="PageMatch" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================== sidebar -->
        <DockPanel Margin="12,12,8,12">
            <!-- brand -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,6,0,22">
                <!-- Strand logo: two points joined by one line, in the phone's Material You colours -->
                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentContainerBrush}">
                    <Canvas Width="24" Height="7">
                        <Rectangle Canvas.Left="3" Canvas.Top="2.5" Width="18" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource OnAccentContainerBrush}" />
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource OnAccentContainerBrush}" />
                        <Ellipse Canvas.Left="17" Width="7" Height="7" Fill="{DynamicResource OnAccentContainerBrush}" />
                    </Canvas>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Strand" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Local sync hub" Style="{StaticResource Caption}" />
                </StackPanel>
            </StackPanel>

            <!-- status chip -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12,10" Margin="0">
                <DockPanel>
                    <Ellipse DockPanel.Dock="Left" Margin="0,0,10,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse" BasedOn="{StaticResource Dot}">
                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="connected">
                                        <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="paused">
                                        <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <StackPanel>
                        <TextBlock Text="{Binding NavStatus}" Style="{StaticResource BodyStrong}" FontSize="13" />
                        <TextBlock Text="Nothing leaves your Wi-Fi" Style="{StaticResource Caption}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- nav -->
            <StackPanel>
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Home"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Home}" />
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xEA86;" Content="Features"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Features}" />
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8EA;" Content="Devices"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Devices}" />
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Settings"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageMatch}, ConverterParameter=Settings}" />
            </StackPanel>
        </DockPanel>

        <!-- ============================== content layer -->
        <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="PageHost" Margin="40,32,40,40" MaxWidth="920" HorizontalAlignment="Stretch" />
            </ScrollViewer>
        </Border>

        <!-- ============================== QuickDrop drag overlay -->
        <Grid x:Name="DropOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" IsHitTestVisible="False" Margin="16">
            <!-- Tint and frame are separate so the tint can be translucent without fading the text. -->
            <Border CornerRadius="12" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Opacity="0.92" />
            <Border CornerRadius="12" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.12" />
            <Border CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE724;" Style="{StaticResource Icon}" FontSize="40" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Drop to send to your phone" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Files and folders · QuickDrop" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
