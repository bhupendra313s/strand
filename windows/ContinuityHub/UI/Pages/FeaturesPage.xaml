<UserControl x:Class="ContinuityHub.UI.Pages.FeaturesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ContinuityHub.UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <ui:NullToCollapsedConverter x:Key="NullToCollapsed" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Features" Style="{StaticResource PageTitle}" />
        <TextBlock Text="Each feature is a self-contained module. Turn them on or off here; your phone's features page has matching switches."
                   Style="{StaticResource PageSubtitle}" />

        <ItemsControl ItemsSource="{Binding Features}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="20,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}" Width="48" Height="48" CornerRadius="12">
                                    <Border.Background>
                                        <DynamicResource ResourceKey="AccentContainerBrush" />
                                    </Border.Background>
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource OnAccentContainerBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" FontSize="15" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding SupportText}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                               Visibility="{Binding SupportText, Converter={StaticResource NullToCollapsed}}"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                                    <Button Content="{Binding Chevron}" Command="{Binding ToggleExpandedCommand}" Margin="12,0,0,0" Padding="8,6"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Background="Transparent" BorderThickness="0"
                                            ToolTip="More settings" AutomationProperties.Name="Show or hide more settings"
                                            Visibility="{Binding SettingsView, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                            </Grid>
                            <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="0,0,8,8" Padding="84,12,20,14">
                                <ContentControl Content="{Binding SettingsView}" IsEnabled="{Binding IsEnabled}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- roadmap: shows the plug-in model has room to grow -->
        <Border CornerRadius="8" Padding="20,18" Margin="0,8,0,0" BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}">
            <Border.Resources>
                <Style TargetType="Border" />
            </Border.Resources>
            <DockPanel>
                <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
                <StackPanel Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="More on the way" Style="{StaticResource BodyStrong}" FontSize="15" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                               Text="Notification mirroring and media controls fit the same model: one module on each side, no changes to pairing or security." />
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
