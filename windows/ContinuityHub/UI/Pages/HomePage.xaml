<UserControl x:Class="ContinuityHub.UI.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ContinuityHub.UI">
    <UserControl.Resources>
        <ui:NullToCollapsedConverter x:Key="NullToCollapsed" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Home" Style="{StaticResource PageTitle}" />
        <TextBlock Text="Your phone and this PC, linked over your own Wi-Fi." Style="{StaticResource PageSubtitle}" />

        <!-- ================= the link: this PC ── phone, in the phone's Material You accent -->
        <Border Style="{StaticResource Card}" Padding="28,24" CornerRadius="16" Margin="0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AccentContainerBrush}">
                            <TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" FontSize="24" Foreground="{DynamicResource OnAccentContainerBrush}" />
                        </Border>
                        <TextBlock Text="This PC" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <ui:LinkLine Grid.Column="1" Margin="8,16,8,0" VerticalAlignment="Top"
                                 IsLinked="{Binding IsLinked}" IsBusy="{Binding IsBusy}" Incoming="{Binding Incoming}" />
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AccentContainerBrush}">
                            <TextBlock Text="&#xE8EA;" Style="{StaticResource Icon}" FontSize="24" Foreground="{DynamicResource OnAccentContainerBrush}" />
                        </Border>
                        <TextBlock Text="{Binding PhoneName}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="96" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusTitle}" FontSize="20" FontWeight="Normal" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding LinkSummary}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsPaused}" VerticalAlignment="Center">
                            <TextBlock Text="Pause" Style="{StaticResource Body}" />
                        </CheckBox>
                        <Button Content="Pair a phone" Command="{Binding PairCommand}" Padding="14,6" Margin="16,0,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ================= QuickDrop: a real drop target, dashed so it reads as one -->
        <Grid Margin="0,12,0,0" AllowDrop="True">
            <Rectangle RadiusX="12" RadiusY="12" StrokeThickness="1.5" StrokeDashArray="4 3"
                       Stroke="{DynamicResource AccentFillColorDefaultBrush}" Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Grid Margin="20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" FontSize="22" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="Drop files or folders here to send them to your phone" Style="{StaticResource Body}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DropMessage}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Choose files" Command="{Binding SendFilesCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="14,6" />
                    <Button Content="Choose a folder" Command="{Binding SendFolderCommand}" Padding="14,6" Margin="8,0,0,0" />
                    <Button Content="&#xE838;" ToolTip="Open Downloads\QuickDrop" AutomationProperties.Name="Open the QuickDrop folder"
                            Command="{Binding OpenDropFolderCommand}" Padding="10,6" Margin="8,0,0,0"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ================= activity -->
        <TextBlock Text="Recent activity" Style="{StaticResource SectionHeader}" />

        <Border Padding="32" x:Name="EmptyState">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Activity.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="32" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Nothing synced yet" Style="{StaticResource BodyStrong}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="Copy some text here, or take a screenshot on your phone and press Ctrl+V." Style="{StaticResource Caption}" TextAlignment="Center" />
            </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Activity}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid VerticalAlignment="Top">
                                <Border Style="{StaticResource IconTile}">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4"
                                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                                    <TextBlock Text="{Binding DirectionGlyph}" Style="{StaticResource Icon}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Caption}" Margin="12,0,0,0" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,3,0,0" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border Grid.Column="2" CornerRadius="6" Height="72" MaxWidth="120" Margin="0,0,12,0" ClipToBounds="True"
                                    BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Visibility="{Binding Thumbnail, Converter={StaticResource NullToCollapsed}}">
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                            </Border>

                            <Button Grid.Column="3" Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" VerticalAlignment="Center"
                                    Visibility="{Binding ActionLabel, Converter={StaticResource NullToCollapsed}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
