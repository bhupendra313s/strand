<UserControl x:Class="ContinuityHub.UI.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- A settings row: icon, label + description, control on the right -->
        <Style x:Key="RowLabel" TargetType="StackPanel">
            <Setter Property="Margin" Value="16,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
        <TextBlock Text="Everything stays on this PC and your local network." Style="{StaticResource PageSubtitle}" />

        <!-- ============ general -->
        <TextBlock Text="General" Style="{StaticResource SectionHeader}" Margin="2,0,0,8" />
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBox DockPanel.Dock="Right" Width="220" VerticalAlignment="Center" Text="{Binding HubName, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" />
                <StackPanel Style="{StaticResource RowLabel}">
                    <TextBlock Text="PC name" Style="{StaticResource Body}" />
                    <TextBlock Text="Shown on your phone and on the local network" Style="{StaticResource Caption}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" />
                <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" />
                <StackPanel Style="{StaticResource RowLabel}">
                    <TextBlock Text="Start with Windows" Style="{StaticResource Body}" />
                    <TextBlock Text="Starts quietly in the system tray when you sign in" Style="{StaticResource Caption}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Notifications}" />
                <TextBlock Text="&#xEA8F;" Style="{StaticResource Icon}" />
                <StackPanel Style="{StaticResource RowLabel}">
                    <TextBlock Text="Notifications" Style="{StaticResource Body}" />
                    <TextBlock Text="Show a notification when something arrives from your phone" Style="{StaticResource Caption}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MatchPhoneColors}" />
                <TextBlock Text="&#xE790;" Style="{StaticResource Icon}" />
                <StackPanel Style="{StaticResource RowLabel}">
                    <TextBlock Text="Match my phone's colours" Style="{StaticResource Body}" />
                    <TextBlock Text="{Binding PhoneColorsNote}" Style="{StaticResource Caption}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsPaused}" />
                <TextBlock Text="&#xE769;" Style="{StaticResource Icon}" />
                <StackPanel Style="{StaticResource RowLabel}">
                    <TextBlock Text="Pause sync" Style="{StaticResource Body}" />
                    <TextBlock Text="Stay connected, but don't send or receive anything" Style="{StaticResource Caption}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ network & security -->
        <TextBlock Text="Network &amp; security" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding NetworkAddress}" Style="{StaticResource Mono}" FontSize="13" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="&#xE701;" Style="{StaticResource Icon}" />
                <StackPanel Style="{StaticResource RowLabel}">
                    <TextBlock Text="Listening on" Style="{StaticResource Body}" />
                    <TextBlock Text="{Binding ServiceName, StringFormat=Discoverable as {0}}" Style="{StaticResource Caption}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Style="{StaticResource RowLabel}">
                    <TextBlock Text="This PC's fingerprint" Style="{StaticResource Body}" />
                    <TextBlock Text="Phones check this before connecting, so nothing can pretend to be your PC." Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Fingerprint}" Style="{StaticResource Mono}" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ about -->
        <TextBlock Text="About" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}" Padding="20">
            <DockPanel>
                <Border Width="56" Height="56" CornerRadius="14" VerticalAlignment="Top">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B82F6" Offset="0" />
                            <GradientStop Color="#7C3AED" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Foreground="White" FontSize="26" />
                </Border>
                <StackPanel Margin="18,0,0,0">
                    <TextBlock Text="Strand" Style="{StaticResource BodyStrong}" FontSize="16" />
                    <TextBlock Text="{Binding Version}" Style="{StaticResource Caption}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                               Text="No accounts, no cloud servers, no telemetry. Data moves only between your devices over your own Wi-Fi, encrypted with certificates that were exchanged by QR code." />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="Open data folder" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenLogCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9F9;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="View log" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding QuitCommand}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="Quit Strand" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
